/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Gradle
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

# Environment files
.env
.env.*

# Database local data folders
postgres-data/
pgdata/

# Redis local persistence
dump.rdb
